# Dev proxy target for /ifc-api (read by vite.config.ts)
# IFC_SERVER_URL=http://localhost:3001

# Default server URL baked into a production build
# VITE_IFC_SERVER_URL=https://ifc.example.com

# Dev proxy target for /model-api (read by vite.config.ts)
# MODEL_STORE_URL=http://localhost:3002

# Default model store URL baked into a production build
# VITE_MODEL_STORE_URL=https://models.example.com
