# Dev and production URLs for IFC server backend services
# Copy this file to .env and modify as needed

# IFC Server URL (for geometry parsing)
# In development: http://localhost:3001 (matches docker-compose ports)
# In production: https://your-ifc-server-domain.com
VITE_IFC_SERVER_URL=http://localhost:3001

# Assistant URL (for AI-powered IFC editing)
# In development: http://localhost:3003 (matches docker-compose ports)
# In production: https://your-assistant-domain.com
VITE_ASSISTANT_URL=http://localhost:3003
